# Supabase (Settings > API in the Supabase dashboard)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (GPT-4o powers the auto-responder)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# WhatsApp Cloud API (Meta for Developers > WhatsApp > API Setup)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=choose-any-random-string-and-reuse-it-in-the-webhook-setup
WHATSAPP_API_VERSION=v20.0

# Telegram (BotFather-issued token, one per tenant bot; multiple tenants can
# share this backend but each needs its own bot token + webhook registered)
TELEGRAM_BOT_TOKEN=

# Google Calendar (service account JSON, shared onto each tenant's calendar)
GOOGLE_CALENDAR_CREDENTIALS_JSON={"type": "service_account", ...}

# SMTP for the weekly owner email report
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Shared secret the external cron caller must send in the X-Cron-Secret header
# when triggering POST /reports/weekly/{tenant_id}
REPORT_CRON_SECRET=
