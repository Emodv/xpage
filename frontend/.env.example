# Supabase (Settings > API in the Supabase dashboard) — anon/public key only.
# The dashboard authenticates as the signed-in owner and relies on Postgres
# Row Level Security to scope every query to their tenant.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# FastAPI backend, for the one action Supabase RLS can't do safely client-side:
# sending an outbound WhatsApp/Telegram message with the provider credentials.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
